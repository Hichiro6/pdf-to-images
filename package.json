    "pdfjs-dist": "6.2.108"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "vite": "5.4.0",
    "vitest": "^4.1.11"
  }
}
